# Local development only. Real credentials are generated into .env.local.
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=gm_electronics
PGUSER=gm_admin
PGPASSWORD=replace_with_generated_password
PORT=3000
HOST=0.0.0.0
EXPOSE_SUPPLIER_PRICES=true
CORS_ORIGINS=*
# Optional: HTTPS public address after deployment.
PUBLIC_BASE_URL=
# Generate privately if administrative routes are needed.
ADMIN_API_KEY=
# Hosting: DATABASE_URL replaces the local PG settings.
# DATABASE_URL=postgresql://user:password@host:5432/database
# TRUST_PROXY_HOPS=1
# Account login: exact Auth Base URL from the existing Neon branch.
# Unset until Neon Auth, verified emails and production SMTP are configured.
NEON_AUTH_BASE_URL=
